rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /users/{uid}/profile/{assetId} {
      allow get: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true;
      allow create: if request.auth != null && request.auth.uid == uid && request.auth.token.email_verified == true
        && assetId.matches('^[0-9]+$') && request.resource.size > 0 && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      allow update, delete, list: if false;
    }
    match /users/{uid}/cards/{cardId}/{assetId} {
      function owner() {
        return request.auth != null && request.auth.uid == uid
          && request.auth.token.email_verified == true;
      }
      allow get: if owner();
      allow create: if owner()
        && cardId.matches('^[a-zA-Z0-9]{20}$') && assetId.matches('^[0-9]+$')
        && request.resource.size > 0 && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Immutable assets: replacement creates a new object.
      allow update, delete, list: if false;
    }
    // A picture sent in a conversation, named after the message that carries
    // it. It lives beside the thread rather than under one account, because
    // both members have to be able to read it for as long as the thread
    // exists -- including after the sender deletes their own photos.
    match /connections/{connectionId}/{messageId} {
      function member() {
        return request.auth != null
          && request.auth.token.email_verified == true
          && request.auth.uid in
            firestore.get(/databases/(default)/documents/connections/$(connectionId)).data.members;
      }
      allow get: if member();
      allow create: if member()
        && request.resource.size > 0 && request.resource.size <= 3 * 1024 * 1024
        && request.resource.contentType.matches('image/(jpeg|png|webp)');
      // Only the backend withdraws an attachment, and only together with the
      // message that named it.
      allow update, delete, list: if false;
    }
  }
}
